<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- ModSecurity IIS - api/ klasörü için devre dışı -->
    <!-- panel.zuliden.com (10.0.0.11) gibi sunucu içi cURL isteklerine izin verir -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
