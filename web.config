<?xml version="1.0" encoding="utf-8"?>
<!-- the root web configuration file -->
<configuration>
  <system.web>
    <compilation tempDirectory="D:\Inetpub\vhosts\ornekproje.com\destek.ornekproje.com\temp" />
    <customErrors mode="Off" />
  </system.web>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Hassas klasör / dosyalara web erişimi kapalı -->
        <rule name="Hassas Klasorleri Engelle" stopProcessing="true">
          <match url="(^|/)(config|temp|logs|vendor|\.git|\.public|\.history|\.lh|\.vscode|\.claude|\.agents|\.github-repo|\.publicignore|\.publicmask)(/|$)" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Erisim engellendi" />
        </rule>
        <!-- Uzak Yönetim: ajan betikleri yalnız api/ajan/kur.php ve dosya.php üzerinden sunulur -->
        <rule name="Uzak Yonetim Ajan Engelle" stopProcessing="true">
          <match url="^(ajan(/|$)|api/ajan/ortak\.php$)" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Erisim engellendi" />
        </rule>
        <!-- SEO Dostu URL'ler - Admin Panel -->
        <rule name="Admin SEO URLs" stopProcessing="true">
          <match url="^admin/([a-z0-9-]+)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="admin/pages/{R:1}.php" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
<!-- api/ klasörü için ModSecurity muafiyeti ayrı web.config ile yönetilmektedir -->